---
// Component: SuburbGrid.astro
---
<!-- 12. LOCAL COVERAGE (WIREFRAME BLOCK 12 - SUBURB GRID) -->
  <section class="py-20 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-xs font-black text-blue-600 dark:text-blue-400 uppercase tracking-widest px-3.5 py-1 rounded-full bg-blue-50 dark:bg-blue-950/50 border border-blue-200 dark:border-blue-800/50">
          Local Brisbane South Coverage
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white mt-3 tracking-tight">
          CCTV Installation Around Stretton
        </h2>
        <!-- Strict wireframe lead preserved -->
        <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base mt-2">
          Restrained local grid across Stretton and immediate southern Brisbane suburbs. Fast mobile dispatch with zero travel surcharges.
        </p>

        <!-- Search input for suburbs -->
        <div class="mt-6 max-w-md mx-auto">
          <input type="text" id="suburb-filter-input" oninput="filterSuburbs(this.value)" placeholder="Search your suburb (e.g. Stretton, Calamvale, Sunnybank Hills)..." class="w-full px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-white/15 text-sm sm:text-base text-slate-900 dark:text-white focus:outline-none focus:border-blue-500" />
        </div>
      </div>

      <!-- Restrained Suburb Grid (Strictly from wireframe) -->
      <div id="suburbs-container" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 text-center">
        
        <div class="suburb-pill glass-box p-3.5 rounded-2xl cursor-pointer hover:border-blue-500 transition-all" onclick="selectSuburbForQuote('Stretton (4116)')">
          <div class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">Stretton</div>
          <div class="text-xs text-blue-600 dark:text-blue-400 font-bold">4116 • Primary</div>
        </div>

        <div class="suburb-pill glass-box p-3.5 rounded-2xl cursor-pointer hover:border-blue-500 transition-all" onclick="selectSuburbForQuote('Calamvale (4116)')">
          <div class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">Calamvale</div>
          <div class="text-xs text-emerald-600 dark:text-emerald-400 font-bold">4116 • Covered</div>
        </div>

        <div class="suburb-pill glass-box p-3.5 rounded-2xl cursor-pointer hover:border-blue-500 transition-all" onclick="selectSuburbForQuote('Sunnybank Hills (4109)')">
          <div class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">Sunnybank Hills</div>
          <div class="text-xs text-emerald-600 dark:text-emerald-400 font-bold">4109 • Covered</div>
        </div>

        <div class="suburb-pill glass-box p-3.5 rounded-2xl cursor-pointer hover:border-blue-500 transition-all" onclick="selectSuburbForQuote('Parkinson (4115)')">
          <div class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">Parkinson</div>
          <div class="text-xs text-emerald-600 dark:text-emerald-400 font-bold">4115 • Covered</div>
        </div>

        <div class="suburb-pill glass-box p-3.5 rounded-2xl cursor-pointer hover:border-blue-500 transition-all" onclick="selectSuburbForQuote('Drewvale (4116)')">
          <div class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">Drewvale</div>
          <div class="text-xs text-emerald-600 dark:text-emerald-400 font-bold">4116 • Covered</div>
        </div>

        <div class="suburb-pill glass-box p-3.5 rounded-2xl cursor-pointer hover:border-blue-500 transition-all" onclick="selectSuburbForQuote('Kuraby (4112)')">
          <div class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">Kuraby</div>
          <div class="text-xs text-emerald-600 dark:text-emerald-400 font-bold">4112 • Covered</div>
        </div>

        <div class="suburb-pill glass-box p-3.5 rounded-2xl cursor-pointer hover:border-blue-500 transition-all" onclick="selectSuburbForQuote('Algester (4115)')">
          <div class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">Algester</div>
          <div class="text-xs text-emerald-600 dark:text-emerald-400 font-bold">4115 • Covered</div>
        </div>

        <div class="suburb-pill glass-box p-3.5 rounded-2xl cursor-pointer hover:border-blue-500 transition-all" onclick="selectSuburbForQuote('Underwood (4119)')">
          <div class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">Underwood</div>
          <div class="text-xs text-emerald-600 dark:text-emerald-400 font-bold">4119 • Covered</div>
        </div>

        <div class="suburb-pill glass-box p-3.5 rounded-2xl cursor-pointer hover:border-blue-500 transition-all" onclick="selectSuburbForQuote('Runcorn (4113)')">
          <div class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">Runcorn</div>
          <div class="text-xs text-emerald-600 dark:text-emerald-400 font-bold">4113 • Covered</div>
        </div>

        <div class="suburb-pill glass-box p-3.5 rounded-2xl cursor-pointer hover:border-blue-500 transition-all" onclick="selectSuburbForQuote('Karawatha (4117)')">
          <div class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">Karawatha</div>
          <div class="text-xs text-emerald-600 dark:text-emerald-400 font-bold">4117 • Covered</div>
        </div>

        <div class="suburb-pill glass-box p-3.5 rounded-2xl cursor-pointer hover:border-blue-500 transition-all" onclick="selectSuburbForQuote('Sunnybank (4109)')">
          <div class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">Sunnybank</div>
          <div class="text-xs text-emerald-600 dark:text-emerald-400 font-bold">4109 • Covered</div>
        </div>

        <div class="suburb-pill glass-box p-3.5 rounded-2xl cursor-pointer hover:border-blue-500 transition-all" onclick="selectSuburbForQuote('Brisbane South Region')">
          <div class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">Brisbane South</div>
          <div class="text-xs text-blue-600 dark:text-blue-400 font-bold">All Suburbs</div>
        </div>

      </div>

    </div>
  </section>
